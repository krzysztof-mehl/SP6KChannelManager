<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Platforms>x86</Platforms>
		<StartupObject>SP6KChannelManager.App</StartupObject>
		<RepositoryUrl>https://github.com/krzysztof-mehl/SP6KChannelManager.git</RepositoryUrl>
		<Authors>Krzysztof Mehl</Authors>
		<Copyright>© 2026 $(Authors)</Copyright>
		<Product>SP6K Channel Manager</Product>
		<VersionPrefix>0.1.0</VersionPrefix>
		<VersionSuffix>alpha.1</VersionSuffix>
		<Title>$(Product)</Title>
		<AssemblyTitle>$(Product)</AssemblyTitle>
		<LangVersion>preview</LangVersion>
		<Description>Simple channel list management for multiple amateur radio transceivers.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>
</Project>
