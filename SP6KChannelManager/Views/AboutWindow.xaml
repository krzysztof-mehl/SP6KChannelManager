<Window x:Class="SP6KChannelManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SP6KChannelManager.ViewModels"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="About"
        Height="450" Width="550" ResizeMode="NoResize">

    <StackPanel Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <StackPanel Orientation="Horizontal" Margin="10" Width="Auto">
            <Image Width="64" Height="64" Margin="0,0,10,0"/>
            <StackPanel Width="Auto">
                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ProductName}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock FontSize="14" Text="{Binding Version}"/>
                    <TextBlock FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding InformationalVersion, StringFormat='({0})'}"/>
                </StackPanel>
                <TextBlock FontSize="14" Margin="0,5,0,0" Text="{Binding Copyright}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Width="500" Text="{Binding Description}"/>
        <TextBox FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" Width="500" Height="270" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Courier New" Text="{Binding LicenseText}"/>
    </StackPanel>
</Window>
